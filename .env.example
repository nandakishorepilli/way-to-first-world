# Copy this file to ".env" (same folder) and fill in real values.
# Get Firebase values from: Firebase Console > Project Settings > General > Your apps
# Get the Maps key from: Google Cloud Console > APIs & Services > Credentials
#
# Vite only exposes env vars prefixed with VITE_ to the browser code.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_GOOGLE_MAPS_API_KEY=
